PERSONA_DATABASE_URL=postgresql+psycopg://persona_lens@127.0.0.1:55432/persona_lens
# Generate once with: uv run python scripts/init_secrets.py
PERSONA_ENCRYPTION_KEY=
# Set true behind HTTPS in shared deployments.
PERSONA_COOKIE_SECURE=false
PERSONA_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]
# Exact base URLs reachable FROM THE API SERVER (include /v1).
PERSONA_DGX_ALLOWED_BASE_URLS=[]
# Local fake-key testing only. Empty means official provider endpoints.
PERSONA_MOCK_PROVIDER_BASE_URL=
# Enable on BOTH API and worker for real OpenAI Responses; no key in this file.
PERSONA_OPENAI_INFERENCE_ENABLED=false
PERSONA_OPENAI_MAX_PEOPLE=10000
PERSONA_OPENAI_MAX_RESPONSES=10000000
PERSONA_OPENAI_MAX_OUTPUT_TOKENS=2048
# Absolute path on the API host. Read-only; never committed or copied into the repository.
PERSONA_PARQUET_PATH=/path/to/ko_KR.parquet
