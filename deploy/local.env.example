# Generate .env.compose with scripts/init_compose.py; do not use empty secrets.
COMPOSE_PROJECT_NAME=persona-lens-local
PERSONA_IMAGE_TAG=local
PERSONA_BIND_ADDRESS=127.0.0.1
PERSONA_HTTP_PORT=8080
PERSONA_HTTPS_PORT=8443
PERSONA_SITE_ADDRESS=:80
PERSONA_COOKIE_SECURE=false
PERSONA_ALLOWED_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
PERSONA_PARQUET_HOST_PATH=/absolute/path/to/ko_KR.parquet
# Hexadecimal passwords avoid URL escaping in PERSONA_DATABASE_URL.
POSTGRES_PASSWORD=
PERSONA_DB_PASSWORD=
PERSONA_ENCRYPTION_KEY=
