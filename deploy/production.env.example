# Preparation only: review DNS, TLS and firewall before running on a server.
# Copy to .env.production (ignored) and fill all secrets; never commit this copy.
COMPOSE_PROJECT_NAME=persona-lens-lab
PERSONA_IMAGE_TAG=replace-with-release-commit
PERSONA_BIND_ADDRESS=0.0.0.0
PERSONA_HTTP_PORT=80
PERSONA_HTTPS_PORT=443
PERSONA_SITE_ADDRESS=https://personas.example.org
PERSONA_COOKIE_SECURE=true
PERSONA_ALLOWED_ORIGINS=["https://personas.example.org"]
PERSONA_PARQUET_HOST_PATH=/srv/persona-lens/data/ko_KR.parquet
PERSONA_DGX_ALLOWED_BASE_URLS=[]
# Independently generated secrets; passwords must be URL-safe (hex recommended).
POSTGRES_PASSWORD=
PERSONA_DB_PASSWORD=
PERSONA_ENCRYPTION_KEY=
